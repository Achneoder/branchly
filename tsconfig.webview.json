{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["svelte"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["webview/**/*.ts", "webview/**/*.svelte", "src/shared/**/*.ts"]
}
