{
  "name": "branchly",
  "displayName": "Branchly",
  "description": "JetBrains-grade Git tooling for VS Code: commit graph, changelists, interactive rebase, conflict resolver, shelf and blame.",
  "version": "0.1.0",
  "publisher": "achneoder",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "scm",
    "diff",
    "rebase",
    "blame",
    "jetbrains"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "branchly",
          "title": "Branchly",
          "icon": "resources/branchly-icon.svg"
        }
      ]
    },
    "views": {
      "branchly": [
        {
          "type": "webview",
          "id": "branchly.main",
          "name": "Branchly"
        }
      ]
    },
    "commands": [
      {
        "command": "branchly.refresh",
        "title": "Refresh",
        "category": "Branchly",
        "icon": "$(refresh)"
      },
      {
        "command": "branchly.openLog",
        "title": "Show Log Tab",
        "category": "Branchly"
      },
      {
        "command": "branchly.openCommit",
        "title": "Show Commit Tab",
        "category": "Branchly"
      },
      {
        "command": "branchly.openConflicts",
        "title": "Show Conflicts Tab",
        "category": "Branchly"
      },
      {
        "command": "branchly.openRebase",
        "title": "Show Rebase Tab",
        "category": "Branchly"
      },
      {
        "command": "branchly.openShelf",
        "title": "Show Shelf Tab",
        "category": "Branchly"
      },
      {
        "command": "branchly.openHistory",
        "title": "Show History Tab",
        "category": "Branchly"
      },
      {
        "command": "branchly.checkoutRevision",
        "title": "Checkout Revision",
        "category": "Branchly"
      },
      {
        "command": "branchly.compareWithLocal",
        "title": "Compare with Local",
        "category": "Branchly"
      },
      {
        "command": "branchly.showDiffWithWorkingTree",
        "title": "Show Diff with Working Tree",
        "category": "Branchly"
      },
      {
        "command": "branchly.cherryPick",
        "title": "Cherry-Pick into Current Branch",
        "category": "Branchly"
      },
      {
        "command": "branchly.rebaseFromHere",
        "title": "Interactively Rebase from Here…",
        "category": "Branchly"
      },
      {
        "command": "branchly.revertCommit",
        "title": "Revert Commit",
        "category": "Branchly"
      },
      {
        "command": "branchly.copyRevisionNumber",
        "title": "Copy Revision Number",
        "category": "Branchly"
      },
      {
        "command": "branchly.newBranchFrom",
        "title": "New Branch from Here…",
        "category": "Branchly"
      },
      {
        "command": "branchly.checkoutBranch",
        "title": "Checkout Branch…",
        "category": "Branchly"
      },
      {
        "command": "branchly.newBranch",
        "title": "New Branch…",
        "category": "Branchly"
      },
      {
        "command": "branchly.stashChanges",
        "title": "Stash Changes…",
        "category": "Branchly"
      },
      {
        "command": "branchly.toggleBlame",
        "title": "Toggle Editor Blame",
        "category": "Branchly"
      },
      {
        "command": "branchly.showBranchPopup",
        "title": "Show Branches…",
        "category": "Branchly"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "branchly.refresh",
          "when": "view == branchly.main",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "branchly.toggleBlame",
          "when": "editorTextFocus",
          "group": "branchly"
        }
      ]
    },
    "keybindings": [
      {
        "command": "branchly.showBranchPopup",
        "key": "ctrl+shift+`",
        "mac": "cmd+shift+`"
      }
    ],
    "configuration": {
      "title": "Branchly",
      "properties": {
        "branchly.appearance.theme": {
          "type": "string",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "default": "auto",
          "description": "Panel color theme. 'auto' follows the active VS Code theme."
        },
        "branchly.appearance.density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ],
          "default": "comfortable",
          "description": "Row density for lists and the commit graph."
        },
        "branchly.appearance.monoGraph": {
          "type": "boolean",
          "default": false,
          "description": "Render the commit graph in a single accent color instead of per-lane colors."
        },
        "branchly.diff.mode": {
          "type": "string",
          "enum": [
            "split",
            "unified"
          ],
          "default": "split",
          "description": "Default diff view mode."
        },
        "branchly.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline blame for the current line in the editor."
        },
        "branchly.log.pageSize": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "Number of commits fetched per page in the Log tab."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production && vite build",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "package": "npm run build && vsce package",
    "lint": "eslint . --ext .ts,.svelte",
    "format": "prettier --check .",
    "check": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig tsconfig.webview.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vscode-test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@eslint/js": "^9.17.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "parse-diff": "^0.12.0",
    "simple-git": "^3.36.0"
  }
}
